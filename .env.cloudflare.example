# Cloudflare Worker secrets (set via: wrangler secret put NAME)
# BETTER_AUTH_SECRET=          # openssl rand -base64 32
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# .dev.vars — local (use 5173 when running Vite + proxy; 8787 if only wrangler dev)
# BETTER_AUTH_URL=http://localhost:5173

# wrangler.toml [vars] — production URL
# BETTER_AUTH_URL=https://sekong.app

# Frontend (optional, after Phase 2 auth cutover)
# VITE_API_BASE_URL=http://localhost:5173

# One-time Supabase → D1 migration (see .env.migration.example)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
