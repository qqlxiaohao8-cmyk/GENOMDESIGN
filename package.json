{
  "name": "genom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:poetry-colors": "node scripts/build-poetic-color-index.mjs",
    "dev": "vite",
    "dev:api": "wrangler dev -c wrangler.api.toml",
    "build": "npm run build:poetry-colors && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:all": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 execute genom-db --local --file=./migrations/d1/0001_app_schema.sql",
    "d1:migrate:remote": "wrangler d1 execute genom-db --remote --file=./migrations/d1/0001_app_schema.sql",
    "auth:schema": "npx @better-auth/cli generate --config workers/auth.cli.ts --output migrations/d1/0002_better_auth.sql -y",
    "d1:migrate:auth:local": "wrangler d1 execute genom-db --local --file=./migrations/d1/0002_better_auth.sql",
    "d1:migrate:auth:remote": "wrangler d1 execute genom-db --remote --file=./migrations/d1/0002_better_auth.sql",
    "migrate:supabase:dry": "node scripts/migrate-supabase-to-d1.mjs --dry-run",
    "migrate:supabase:local": "node scripts/migrate-supabase-to-d1.mjs --target local",
    "migrate:supabase:remote": "node scripts/migrate-supabase-to-d1.mjs --target remote",
    "migrate:supabase:export": "node scripts/migrate-supabase-to-d1.mjs --export-only",
    "seed:curated": "node scripts/generate-curated-seed.mjs",
    "seed:curated:import": "node scripts/generate-curated-seed.mjs --import-local",
    "seed:curated:import:remote": "node scripts/generate-curated-seed.mjs --import-remote",
    "seed:delete:xlsx": "node scripts/delete-xlsx-seed.mjs --remote --clean-local",
    "seed:delete:curated": "node scripts/delete-curated-seed.mjs --remote --r2 --clean-local",
    "seed:v2": "node scripts/generate-v2-seed.mjs",
    "seed:v2:import": "node scripts/generate-v2-seed.mjs --import-local",
    "seed:v2:import:remote": "node scripts/generate-v2-seed.mjs --import-remote",
    "seed:v3": "node scripts/generate-v3-seed.mjs",
    "seed:v3:import": "node scripts/generate-v3-seed.mjs --import-local",
    "seed:v3:import:remote": "node scripts/generate-v3-seed.mjs --import-remote",
    "seed:delete:v3": "node scripts/delete-v3-seed.mjs --remote --r2 --clean-local"
  },
  "dependencies": {
    "better-auth": "^1.5.0",
    "hono": "^4.7.0",
    "lucide-react": "^0.483.0",
    "pinyin-pro": "^3.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.2",
    "wrangler": "^4.76.0"
  }
}
