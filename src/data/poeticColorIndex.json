e":"宿建德江"},{"hex":"#4C8DA2","name2":"江霭","poem":"日暮乡关何处是，烟波江上使人愁","poet":"崔颢","source":"黄鹤楼"},{"hex":"#4D9DAA","name2":"望缥","poem":"望缥缈、五云深处移蓬岛","poet":"李昴英","source":"摸鱼儿"},{"hex":"#4E020F","name2":"绛宫","poem":"绛宫深锁暮云浮","poet":"谢逸","source":"西江月"},{"hex":"#501B6F","name2":"紫云","poem":"紫云深、参差禁树，有烟花绕","poet":"刘过","source":"贺新郎"},{"hex":"#507E96","name2":"江练","poem":"一道残阳铺水中，半江瑟瑟半江红","poet":"白居易","source":"暮江吟"},{"hex":"#510000","name2":"雪朱","poem":"前溪昨夜深深雪，朱颜不掩天真","poet":"晏殊","source":"瑞鹧鸪"},{"hex":"#513126","name2":"昏檀","poem":"不堪相望病将成，钿昏檀粉泪纵横，不胜情","poet":"鹿虔扆","source":"虞美人·卷荷香淡浮烟渚"},{"hex":"#516A7B","name2":"茫茫","poem":"事茫茫、赤壁半帆风，四海忽三分","poet":"王质","source":"八声甘州"},{"hex":"#519D55","name2":"露绿","poem":"并刀翦叶，一枝晓露，绿鬓曾簪","poet":"吴文英","source":"朝中措"},{"hex":"#528678","name2":"碧空","poem":"碧空暗淡同云绕","poet":"陈瓘","source":"青玉案"},{"hex":"#528B8E","name2":"青毡","poem":"青毡旧，看崇诗说礼，缓带轻裘","poet":"李曾伯","source":"沁园春"},{"hex":"#529C89","name2":"愁碧","poem":"楼锁轻烟，水横斜照，遥山半隐愁碧","poet":"柳永","source":"倾杯乐"},{"hex":"#532D0F","name2":"要褐","poem":"岁云暮，须早计，要褐裘","poet":"苏轼","source":"水调歌头"},{"hex":"#536048","name2":"依依","poem":"依依翠屏香冷，听夜雨、动离情","poet":"陈允平","source":"绮寮怨"},{"hex":"#551018","name2":"绛阙","poem":"绛阙真仙来瑞世，昨夜翔鸾飞鹄","poet":"无名氏","source":"满江红"},{"hex":"#567556","name2":"青青","poem":"黄昏半窗淡月，照青青、谢池春草","poet":"张榘","source":"孤鸾"},{"hex":"#5698C4","name2":"澄宇","poem":"秋水共长天一色","poet":"王勃","source":"滕王阁序"},{"hex":"#57966E","name2":"笼翠","poem":"昵昵琵琶恩怨语，春笋轻笼翠袖","poet":"刘过","source":"贺新郎"},{"hex":"#593F4B","name2":"脉脉","poem":"梅失黄昏，雁惊白昼，脉脉斜飞云表","poet":"张炎","source":"法曲献仙音"},{"hex":"#5A694B","name2":"依依","poem":"暗碧柳色依依，湖上迷青雾","poet":"陈允平","source":"荔枝香近・荔枝香"},{"hex":"#5A7240","name2":"依依","poem":"芳友依依，结根遥向深林外","poet":"王十朋","source":"点绛唇"},{"hex":"#5B904F","name2":"萋萋","poem":"乱碧萋萋，雨后江天晓","poet":"梅尧臣","source":"苏幕遮"},{"hex":"#5B935D","name2":"新绿","poem":"一霎轻云过雨，半篙新绿横舟","poet":"王之道","source":"西江月"},{"hex":"#5C2A17","name2":"粉檀","poem":"落花深处，啼鸟似逐离散，粉檀珠泪和","poet":"李珣","source":"河传·春暮"},{"hex":"#5D0007","name2":"泪红","poem":"夜深忽夢少年事，夢啼妝泪红闌干","poet":"白居易","source":"琵琶引"},{"hex":"#5D0C01","name2":"李赤","poem":"敲门夜半窥园李，赤脚玉川惊走","poet":"刘辰翁","source":"摸鱼儿"},{"hex":"#5D5D63","name2":"轻黛","poem":"晚寒伫立，记铅轻黛浅，初认冰魂","poet":"王沂孙","source":"露华"},{"hex":"#5D7587","name2":"茫茫","poem":"上穷碧落下黄泉，兩处茫茫皆不见","poet":"白居易","source":"长恨歌"},{"hex":"#5E347A","name2":"日紫","poem":"今日紫阳峰顶上，人望旌旗天半","poet":"汪莘","source":"念奴娇"},{"hex":"#5F5D38","name2":"苔褐","poem":"绿蚁新醅酒，红泥小火炉","poet":"白居易","source":"问刘十九"},{"hex":"#5FA995","name2":"浅碧","poem":"知何似，似一钩新月，浅碧笼云","poet":"刘过","source":"沁园春"},{"hex":"#60808B","name2":"苍颜","poem":"苍颜照影，故应流落，轻裘肥马","poet":"辛弃疾","source":"水龙吟"},{"hex":"#614909","name2":"敧金","poem":"寒夜愁敧金带枕，暮江深闭木兰船","poet":"王琪","source":"望江南・忆江南"},{"hex":"#61774B","name2":"依依","poem":"两株烟柳荒城外，依依暮帆曾驻","poet":"丁默","source":"齐天乐"},{"hex":"#61AC85","name2":"竹露","poem":"独坐幽篁里，弹琴复长啸","poet":"王维","source":"竹里馆"},{"hex":"#629092","name2":"嫩青","poem":"三杯淡酒，玉腴蔬嫩，青缕堆盘","poet":"陈三聘","source":"朝中措"},{"hex":"#632D6F","name2":"佩霓","poem":"扁舟夜宿吴江，正水佩霓裳无数","poet":"吴文英","source":"惜秋华"},{"hex":"#636269","name2":"螺黛","poem":"浅螺黛，淡胭脂","poet":"张先","source":"醉桃源・阮郎归"},{"hex":"#639B77","name2":"翡翠","poem":"想像靓妆淡伫，钗头翡翠茧蛾儿","poet":"无名氏","source":"庆清朝"},{"hex":"#64374D","name2":"脉脉","poem":"翠华脉脉东封事，日观云深万仞青","poet":"晁端礼","source":"鹧鸪天"},{"hex":"#65929A","name2":"香缥","poem":"蕙草繁花竞吐，向暗里、幽香缥缈","poet":"刘子寰","source":"玉漏迟"},{"hex":"#663C23","name2":"杖棕","poem":"藜杖棕鞋，纶巾鹤氅，宾主俱遗俗","poet":"沈端节","source":"念奴娇"},{"hex":"#663F31","name2":"檀口","poem":"檀口未歌先愠泪，柳眉将敛半凝羞","poet":"赵长卿","source":"瑞鹧鸪"},{"hex":"#663F52","name2":"脉脉","poem":"天寒日暮，含香脉脉无言","poet":"王之道","source":"汉宫春"},{"hex":"#66442C","name2":"短褐","poem":"幅巾短褐，有些野逸，有些村拗","poet":"刘克庄","source":"水龙吟"},{"hex":"#665A59","name2":"暮砚","poem":"月落乌啼霜满天，江枫渔火对愁眠","poet":"张继","source":"枫桥夜泊"},{"hex":"#66A9C9","name2":"溪蓝","poem":"青山隐隐水迢迢，秋尽江南草未凋","poet":"杜牧","source":"寄扬州韩绰判官"},{"hex":"#679F69","name2":"阴绿","poem":"疏疏翠竹，阴阴绿树，浅浅寒沙","poet":"辛弃疾","source":"玉蝴蝶"},{"hex":"#682229","name2":"葱茜","poem":"新腔按彻，背灯暗、共倚篔屏葱茜","poet":"吴文英","source":"绛都春"},{"hex":"#694E00","name2":"付金","poem":"暗付金钗清夜半","poet":"欧阳修","source":"渔家傲"},{"hex":"#694E7C","name2":"淡紫","poem":"幽芳月淡，紫曲云昏，有人说著","poet":"赵闻礼","source":"瑞鹤仙"},{"hex":"#6A3F86","name2":"紫泉","poem":"紫泉宮殿锁烟霞，欲取蕪城作帝家","poet":"李商隐","source":"隋宮"},{"hex":"#6B5A0C","name2":"黄昏","poem":"黄昏著了素衣裳，深闭重门听夜雨","poet":"史达祖","source":"玉楼春"},{"hex":"#6C1612","name2":"断丹","poem":"白狼河北音书断，丹凤城南秋夜长","poet":"沈佺期","source":"古意呈補闕喬知之"},{"hex":"#6C3435","name2":"度绛","poem":"对静夜无眠，稀星散、时度绛河清浅","poet":"王沂孙","source":"金盏子"},{"hex":"#6C9264","name2":"萋萋","poem":"渐萋萋、芳草绿江南，轻晖弄春容","poet":"周密","source":"甘州・八声甘州"},{"hex":"#6E2219","name2":"朱阑","poem":"朱阑夜悄，蟾华如水，初照清影","poet":"曹勋","source":"月上海棠慢・月上海棠"},{"hex":"#6E337B","name2":"楚霓","poem":"凄楚霓裳，琼阙瑶台，经年暗锁清逸","poet":"施枢","source":"疏影"},{"hex":"#6E3D3D","name2":"夜绛","poem":"采蝀横斜春不夜，绛霞浓淡月微明","poet":"范成大","source":"浣溪沙"},{"hex":"#6E4D5C","name2":"脉脉","poem":"欲上香车俱脉脉，半帘花影月平西","poet":"蔡伸","source":"定风波"},{"hex":"#6E8EA5","name2":"茫茫","poem":"竟茫茫未晓","poet":"辛弃疾","source":"水龙吟"},{"hex":"#6EAD9C","name2":"淡碧","poem":"一声声送一声悲，云淡碧天如水","poet":"无名氏","source":"御街行"},{"hex":"#709C71","name2":"青青","poem":"渭城朝雨浥轻塵，客舍青青杨柳春","poet":"王維","source":"渭城曲"},{"hex":"#717884","name2":"夜银","poem":"深秋寒夜银河静，月明深院中庭","poet":"尹鹗 六首","source":"临江仙·深秋寒夜银河静"},{"hex":"#7196BC","name2":"笼蓝","poem":"越梅半坼轻寒里，冰清淡薄笼蓝水","poet":"和凝","source":"菩萨蛮·越梅半坼轻寒里"},{"hex":"#720119","name2":"熏绛","poem":"深炷龙津，浓熏绛帏，博山频揭","poet":"杨无咎","source":"曲江秋"},{"hex":"#724A3C","name2":"檀车","poem":"檀车幝幝，四牡痯痯，征夫不远","poet":"佚名","source":"杕杜"},{"hex":"#725D68","name2":"紫陌","poem":"去年今日此门中，人面桃花相映红","poet":"崔护","source":"题都城南庄"},{"hex":"#729CC8","name2":"挼蓝","poem":"浅浅挼蓝轻蜡透","poet":"周邦彦","source":"蝶恋花"},{"hex":"#737F88","name2":"茫茫","poem":"暮云四卷，淡星河、天影茫茫垂碧","poet":"李纲","source":"念奴娇"},{"hex":"#7397AB","name2":"沧浪","poem":"沧浪之水清兮，可以濯我缨","poet":"《楚辞》","source":"渔父"},{"hex":"#74787C","name2":"寒石","poem":"柴门闻犬吠，风雪夜归人","poet":"刘长卿","source":"逢雪宿芙蓉山主人"},{"hex":"#74ACB6","name2":"畔缥","poem":"半蜃起玲珑楼阁畔，缥缈鸿去绝","poet":"吴文英","source":"浪淘沙慢"},{"hex":"#755914","name2":"促金","poem":"春夜阑，更漏促，金烬暗挑残烛","poet":"牛峤","source":"更漏子·春夜阑"},{"hex":"#75620B","name2":"语黄","poem":"绣幕灯深绿暗，画帘人语黄昏","poet":"陈师道","source":"西江月"},{"hex":"#762F06","name2":"树赭","poem":"暮屏翠冷，秋树赭疏，双峰对起南北","poet":"张矩","source":"应天长"},{"hex":"#768193","name2":"深银","poem":"画堂深，银烛暗，重门闭","poet":"无名氏","source":"千秋岁令・千秋岁引"},{"hex":"#798C9A","name2":"清霜","poem":"只恐夜深花睡，五更微有清霜","poet":"刘仙伦","source":"木兰花慢"},{"hex":"#7A0C04","name2":"断虹","poem":"楼阁濛濛，断虹明处，十里暮云深","poet":"赵子发","source":"少年游"},{"hex":"#7A8E67","name2":"依依","poem":"別夢依依到谢家，小廊回合曲闌斜","poet":"張泌","source":"寄人 一"},{"hex":"#7C2524","name2":"碎红","poem":"曲池连夜雨，绿水上、碎红千片","poet":"杜安世","source":"忆汉月"},{"hex":"#7C271C","name2":"豪朱","poem":"才大文豪，朱衣暗里，今须点头","poet":"卓田","source":"沁园春"},{"hex":"#7C6353","name2":"驼褐","poem":"驼褐寒侵，正怜初日，轻阴抵死须遮","poet":"周邦彦","source":"西平乐"},{"hex":"#7D000F","name2":"落红","poem":"薄暮归吟芳草路，落红深处鹧鸪声","poet":"赵长卿","source":"浣溪沙"},{"hex":"#7E6B1B","name2":"半黄","poem":"夜半黄昏担带了，多少清风明月","poet":"赵长卿","source":"念奴娇"},{"hex":"#7F180E","name2":"岩虹","poem":"气压暗岩虹半吐，眼明平楚云相逐","poet":"魏了翁","source":"满江红"},{"hex":"#7F8793","name2":"寸灰","poem":"春心莫共花争发，一寸相思一寸灰","poet":"李商隐","source":"无题四首 二"},{"hex":"#815476","name2":"丁香","poem":"芭蕉不展丁香结，同向春风各自愁","poet":"李商隐","source":"代赠"},{"hex":"#81B9C3","name2":"香缥","poem":"况兰堂逢著寿筵开，见炉香缥缈","poet":"晏殊","source":"连理枝"},{"hex":"#835242","name2":"晓檀","poem":"梦寒绡帐春风晓，檀枕半堆香髻","poet":"胡仔","source":"水龙吟"},{"hex":"#8353A3","name2":"紫骝","poem":"紫骝嘶冻草，晓云锁、岫眉颦","poet":"吴文英","source":"木兰花慢"},{"hex":"#83609D","name2":"溅紫","poem":"轻淘起，香生玉尘，雪溅紫瓯圆","poet":"秦观","source":"满庭芳"},{"hex":"#836417","name2":"月金","poem":"淮山夜月，金城暮草，梦魂飞去","poet":"周邦彦","source":"宴清都"},{"hex":"#83A5B0","name2":"沧浪","poem":"风悲兰杜，烟淡沧浪，何处扁舟","poet":"唐庚","source":"诉衷情"},{"hex":"#84353B","name2":"缕茜","poem":"想绮窗、刺绣迟了，半缕茜茸微绕","poet":"李从周","source":"玲珑四犯"},{"hex":"#85919A","name2":"茫茫","poem":"曲栏干外，汀烟轻冉冉，莎草细茫茫","poet":"张元干","source":"风流子"},{"hex":"#85BF86","name2":"云绿","poem":"银浦流云，绿房迎晓，一抹墙腰月淡","poet":"张炎","source":"探春慢"},{"hex":"#863D4D","name2":"鸿胭","poem":"羞对钗燕筝鸿，胭脂暗弹泪","poet":"向希尹","source":"祝英台近"},{"hex":"#86898F","name2":"银蟾","poem":"半夜卷帘如乍失，只在银蟾影里","poet":"蒲宗孟","source":"望梅花"},{"hex":"#876A60","name2":"瘦檀","poem":"玉瘦檀轻无限恨，南楼羌管休吹","poet":"魏夫人","source":"临江仙"},{"hex":"#877F74","name2":"尘褐","poem":"古道西风瘦马，夕阳西下","poet":"马致远","source":"天净沙·秋思"},{"hex":"#883A2C","name2":"游赤","poem":"壬戍孟秋，苏子夜游，赤壁舟轻漾","poet":"曹冠","source":"哨遍"},{"hex":"#8976AB","name2":"兰夜","poem":"月出惊山鸟，时鸣春涧中","poet":"王维","source":"鸟鸣涧"},{"hex":"#89939E","name2":"深雪","poem":"半夜衔枚，满城深雪，忽已亡悬瓠","poet":"李纲","source":"念奴娇"},{"hex":"#8A0509","name2":"醺丹","poem":"风动霞衣香散漫，酒醺丹脸深沈","poet":"无名氏","source":"临江仙"},{"hex":"#8A4432","name2":"蒨霞","poem":"蒨霞艳锦，星媛夜织，河汉鸣杼","poet":"吴文英","source":"绕佛阁"},{"hex":"#8B3A3A","name2":"赤槿","poem":"落红不是无情物，化作春泥更护花","poet":"龚自珍","source":"己亥杂诗"},{"hex":"#8B4513","name2":"松烟","poem":"松下问童子，言师采药去","poet":"贾岛","source":"寻隐者不遇"},{"hex":"#8B492A","name2":"侍赭","poem":"看看也，天边凤诏，归侍赭袍光","poet":"汪莘","source":"满庭芳"},{"hex":"#8C7616","name2":"月黄","poem":"前村昨夜，想弄月、黄昏时候","poet":"周邦彦","source":"玉烛新"},{"hex":"#8D1B17","name2":"牡丹","poem":"是三春已暮，浪蕊彤残，牡丹零落","poet":"赵长卿","source":"醉蓬莱"},{"hex":"#8D1C11","name2":"下朱","poem":"新妝面面下朱楼，深锁春光一院愁","poet":"劉禹锡","source":"和乐天春词"},{"hex":"#8DB79A","name2":"横翠","poem":"淡烟轻、疏林映带，远山横翠","poet":"葛长庚","source":"贺新郎"},{"hex":"#8E453F","name2":"丹枫","poem":"停车坐爱枫林晚，霜叶红于二月花","poet":"杜牧","source":"山行"},{"hex":"#8E6C12","name2":"楼金","poem":"云暮暗千山，肠断玉楼金阕","poet":"范成大","source":"好事近"},{"hex":"#8EA1B0","name2":"护霜","poem":"护霜云澹兰皋暮，行人怕临昏晚","poet":"杨泽民","source":"齐天乐"},{"hex":"#8F7983","name2":"脉脉","poem":"脉脉凭栏，槐阴转午，轻摇歌扇","poet":"汪元量","source":"失调名"},{"hex":"#8FB2C9","name2":"汀蓝","poem":"孤帆远影碧空尽，唯见长江天际流","poet":"李白","source":"黄鹤楼送孟浩然之广陵"},{"hex":"#8FC4B5","name2":"浅碧","poem":"潋滟光凝盏面，轻风皱、浅碧宫罗","poet":"无名氏","source":"满庭芳"},{"hex":"#90302E","name2":"青红","poem":"灯晕青红残醉在，小院屏昏帐暝","poet":"蒋捷","source":"贺新郎"},{"hex":"#907C2E","name2":"想黄","poem":"想黄昏云淡，夜深人静，清影横窗","poet":"刘沆","source":"甘州・八声甘州"},{"hex":"#908188","name2":"脉脉","poem":"脉脉花疏天淡，云来去、数枝雪","poet":"范成大","source":"霜天晓角"},{"hex":"#90A879","name2":"依依","poem":"燕子依依，晓来总为谁归去","poet":"无名氏","source":"点绛唇"},{"hex":"#914046","name2":"疏茜","poem":"藓佩萧疏，茜裙零乱，山意霏霏","poet":"王沂孙","source":"一萼红"},{"hex":"#91A0B1","name2":"漫漫","poem":"故園东望路漫漫，双袖龙钟泪不乾","poet":"岑參","source":"逢入京使"},{"hex":"#92959C","name2":"银箏","poem":"银箏夜久殷勤弄，心怯空房不忍归","poet":"王涯","source":"秋夜曲"},{"hex":"#932605","name2":"叶霞","poem":"落叶霞翻，败窗风咽，暮色凄凉深院","poet":"吴文英","source":"法曲献仙音"},{"hex":"#949C51","name2":"苇黄","poem":"关关雎鸠，在河之洲","poet":"《诗经》","source":"关雎"},{"hex":"#9553A4","name2":"破霓","poem":"漁阳鞞鼓動地来，惊破霓裳羽衣曲","poet":"白居易","source":"长恨歌"},{"hex":"#95A0AB","name2":"深雪","poem":"夜来深雪前村路，应是早梅初绽","poet":"晁端礼","source":"水龙吟"},{"hex":"#964D09","name2":"染橙","poem":"手染橙芗，杯摇烛影，夜阑人意醺酣","poet":"蔡楠","source":"满庭芳"},{"hex":"#966C7F","name2":"脉脉","poem":"甚脉脉、阑干凭晓，一握乱丝如柳","poet":"仇远","source":"薄幸"},{"hex":"#968E82","name2":"素蛾","poem":"素蛾洗尽繁妆，夜深步月秋千地","poet":"楼枎","source":"水龙吟"},{"hex":"#96958F","name2":"纤白","poem":"渐夜久、闲引流萤，弄微照素怀，暗呈纤白","poet":"吴文英","source":"解连环"},{"hex":"#96A6BE","name2":"壶银","poem":"洞房花烛深深处，慢转铜壶银漏","poet":"赵文","source":"玉烛新"},{"hex":"#96C24E","name2":"柳烟","poem":"碧玉妆成一树高，万条垂下绿丝绦","poet":"贺知章","source":"咏柳"},{"hex":"#974936","name2":"烟霞","poem":"暗期归路指烟霞","poet":"贺铸","source":"第一花・鹧鸪天"},{"hex":"#977E0D","name2":"月黄","poem":"横溪浸疏影，月黄昏、暗香浮动","poet":"张侃","source":"月上海棠"},{"hex":"#97A3AD","name2":"昏霜","poem":"倚竹天寒，吟香夜冷，几度月昏霜晓","poet":"周密","source":"齐天乐"},{"hex":"#993A2E","name2":"朱帘","poem":"朱帘半卷，单衣初试，清明时候","poet":"秦观","source":"水龙吟"},{"hex":"#99C199","name2":"淡绿","poem":"天气有时阴淡淡，绿杨轻软","poet":"杜安世","source":"安公子"},{"hex":"#9A4156","name2":"得胭","poem":"东风日暮无聊赖，吹得胭脂成粉","poet":"刘克庄","source":"摸鱼儿"},{"hex":"#9AA2AE","name2":"翦银","poem":"夜半翦银河，到人间、楼台初晓","poet":"何梦桂","source":"蓦山溪"},{"hex":"#9AAABA","name2":"肌雪","poem":"画楼深闭，想见东风，暗销肌雪","poet":"张元干","source":"石州慢"},{"hex":"#9B8B86","name2":"注檀","poem":"浅眉微敛注檀轻，旧欢时有梦魂惊，悔多情","poet":"顾敻","source":"虞美人·翠屏闲掩垂珠箔"},{"hex":"#9B9FA5","name2":"声银","poem":"欲寻无处，暗掐新声，银屏斜掩","poet":"张炎","source":"烛影摇红"},{"hex":"#9BBCD5","name2":"早霜","poem":"君知否，山深地僻，自是早霜天","poet":"程珌","source":"满庭芳"},{"hex":"#9C7B31","name2":"金屋","poem":"金屋妝成嬌侍夜，玉楼宴罷醉和春","poet":"白居易","source":"长恨歌"},{"hex":"#9CAA90","name2":"依依","poem":"空怜断梗梦依依，岁华轻别","poet":"张炎","source":"凄凉犯"},{"hex":"#9D2933","name2":"胭云","poem":"何须浅碧深红色，自是花中第一流","poet":"李清照","source":"鹧鸪天"},{"hex":"#9D9C91","name2":"动白","poem":"莫怨歌，夜深岩下，惊动白云宿","poet":"辛弃疾","source":"归朝欢"},{"hex":"#9DC9BC","name2":"碧雾","poem":"碧雾轻笼两凤，寒烟淡拂双鸦","poet":"苏轼","source":"西江月"},{"hex":"#9E170C","name2":"虹桥","poem":"虹桥望断，琼楼深锁，如今谁住","poet":"韩元吉","source":"水龙吟"},{"hex":"#9E4F3B","name2":"残霞","poem":"残霞零落晚烟昏","poet":"葛郯","source":"鹧鸪天"},{"hex":"#9FC79F","name2":"齿绿","poem":"稚颜皓齿，绿发方瞳，圆极恬淡高妍","poet":"苏轼","source":"戚氏"},{"hex":"#A0ACBE","name2":"阳银","poem":"暮蝉声尽落斜阳，银蟾影挂潇湘","poet":"毛文锡","source":"临江仙·暮蝉声尽落斜阳"},{"hex":"#A0D2B1","name2":"冷翠","poem":"香冷翠屏春意靓，明月淡、晓风轻","poet":"周密","source":"江城子"},{"hex":"#A1281B","name2":"暮虹","poem":"五弦弹尽，隐隐天末暮虹收","poet":"葛郯","source":"水调歌头"},{"hex":"#A29B7C","name2":"古驿","poem":"长亭外，古道边，芳草碧连天","poet":"李叔同","source":"送别"},{"hex":"#A2A9AD","name2":"微霜","poem":"朝聞游子唱离歌，昨夜微霜初渡河","poet":"李頎","source":"送魏万之京"},{"hex":"#A35162","name2":"得胭","poem":"半怯春寒，半便晴色，养得胭脂透","poet":"张","source":"念奴娇"},{"hex":"#A35303","name2":"枯橙","poem":"菊暗荷枯，橙黄桔绿，嘉时记得今朝","poet":"杨无咎","source":"望海潮"},{"hex":"#A43C33","name2":"子丹","poem":"岑夫子，丹丘生，將进酒，杯莫停","poet":"李白","source":"鼓吹曲辞 將进酒"},{"hex":"#A45859","name2":"花绛","poem":"轻妆了，袅凉花绛缕，香满鸾镜","poet":"周密","source":"大圣乐"},{"hex":"#A47F73","name2":"沈檀","poem":"晓妆初过，沈檀轻注些儿个","poet":"李煜","source":"一斛珠·晓妆初过"},{"hex":"#A49C9F","name2":"脉脉","poem":"黛浅波娇情脉脉，云轻柳弱意真真","poet":"何作善","source":"浣溪沙"},{"hex":"#A57C02","name2":"深金","poem":"邃馆静深，金铺半掩，重帘垂地","poet":"蔡伸","source":"喜迁莺"},{"hex":"#A5A19B","name2":"邀素","poem":"待行过溪桥，夜半更邀素月","poet":"辛弃疾","source":"永遇乐"},{"hex":"#A66161","name2":"淡绛","poem":"香味已惊樱实淡，绛皮还笑荔枝皴","poet":"无名氏","source":"浣溪沙"},{"hex":"#A67C52","name2":"茶褐","poem":"寒夜客来茶当酒，竹炉汤沸火初红","poet":"杜耒","source":"寒夜"},{"hex":"#A6B3BD","name2":"质霜","poem":"丽质霜裾真性雅，馀香暗送人来","poet":"无名氏","source":"临江仙"},{"hex":"#A78D8B","name2":"烟粉","poem":"云鬓花颜金步摇，芙蓉帐暖度春宵","poet":"白居易","source":"长恨歌"},{"hex":"#A7C2D5","name2":"澹霜","poem":"月胧烟澹霜蹊滑，孤宿暮林荒驿","poet":"沈端节","source":"五福降中天"},{"hex":"#A83825","name2":"流赤","poem":"当流赤足蹋澗石，水声激激风吹衣","poet":"韓愈","source":"山石"},{"hex":"#A85A16","name2":"橙黄","poem":"橙黄橘绿，可人风物是秋深","poet":"丘崈","source":"水调歌头"},{"hex":"#A8B07C","name2":"麦秋","poem":"稻花香里说丰年，听取蛙声一片","poet":"辛弃疾","source":"西江月"},{"hex":"#A91B0D","name2":"丹砂","poem":"葡萄美酒夜光杯，欲饮琵琶马上催","poet":"王翰","source":"凉州词"},{"hex":"#A93F56","name2":"静嫣","poem":"雕玉阑干深院静，嫣然凝笑西风","poet":"张抡","source":"临江仙"},{"hex":"#A98175","name2":"檀烟","poem":"炉香静逐游丝转，一座轻尘","poet":"晏殊","source":"浣溪沙"},{"hex":"#AA442B","name2":"烟霞","poem":"但喜吾翁躔度转，唤起烟霞深痼","poet":"方岳","source":"酹江月・念奴娇"},{"hex":"#ABBFDF","name2":"教银","poem":"深杯休诉，任教银漏催晓","poet":"沈端节","source":"念奴娇"},{"hex":"#AC942F","name2":"间黄","poem":"夜雨剪春韭，新炊间黄粱","poet":"杜甫","source":"贈卫八处士"},{"hex":"#ACB2B7","name2":"似雪","poem":"昨夜半开时，似雪到、梢头未遍","poet":"无名氏","source":"蓦山溪"},{"hex":"#AD4E37","name2":"绮霞","poem":"绮霞低映，步障横陈，暮天慵倦","poet":"卢祖皋","source":"瑞鹤仙"},{"hex":"#AD7C2F","name2":"煌煌","poem":"昏以为期，明星煌煌","poet":"佚名","source":"东门之杨"},{"hex":"#AEC4DA","name2":"外雪","poem":"坐中人半醉，帘外雪将深","poet":"苏轼","source":"临江仙"},{"hex":"#AF76BC","name2":"爲霓","poem":"轻攏慢撚抹復挑，初爲霓裳后六幺","poet":"白居易","source":"琵琶引"},{"hex":"#B05459","name2":"葱茜","poem":"送晓色、一壶葱茜，才知花梦准","poet":"吴文英","source":"花犯"},{"hex":"#B068C1","name2":"底霓","poem":"洗烟凝露向清晓，步瑶台、月底霓裳","poet":"康与之","source":"舞杨花"},{"hex":"#B0A4E3","name2":"藕梦","poem":"试问卷帘人，却道海棠依旧","poet":"李清照","source":"如梦令"},{"hex":"#B1ADA7","name2":"素蛾","poem":"素蛾今夜，故故随人，似斗婵娟","poet":"苏轼","source":"诉衷情"},{"hex":"#B1D5DC","name2":"缥缈","poem":"缥缈仙云随宝仗，轻盈衣裓贮天华","poet":"净圆","source":"望江南・忆江南"},{"hex":"#B2881E","name2":"合金","poem":"唯將旧物表深情，鈿合金釵寄將去","poet":"白居易","source":"长恨歌"},{"hex":"#B29E51","name2":"月黄","poem":"疏影横斜水清浅，暗香浮动月黄昏","poet":"林逋","source":"瑞鹧鸪"},{"hex":"#B54A46","name2":"灯红","poem":"隔座送鉤春酒暖，分曹射覆蠟灯红","poet":"李商隐","source":"无题二首 一"},{"hex":"#B5C5DF","name2":"银烛","poem":"银烛晓催春漏，珠帘暮卷东风","poet":"无名氏","source":"西江月"},{"hex":"#B64B65","name2":"力胭","poem":"晓妆无力胭脂重，春醉方酣酒晕深","poet":"尤袤","source":"瑞鹧鸪"},{"hex":"#B69D3A","name2":"掩黄","poem":"对重门半掩，黄昏淡月，院宇深寂","poet":"周邦彦","source":"瑞鹤仙"},{"hex":"#B6A461","name2":"破黄","poem":"淡月破黄昏，影浮疏、清香暗度","poet":"无名氏","source":"蓦山溪"},{"hex":"#B6C3CD","name2":"分霜","poem":"昨夜十分霜重，晓来千里书传","poet":"李之仪","source":"西江月"},{"hex":"#B6D9B6","name2":"青青","poem":"铜驼烟淡晓风轻，摇曳青青柳","poet":"赵长卿","source":"烛影摇红"},{"hex":"#B7AE8F","name2":"沙月","poem":"黄河远上白云间，一片孤城万仞山","poet":"王之涣","source":"凉州词"},{"hex":"#B94739","name2":"雄虹","poem":"建雄虹之采旄兮，五色杂而炫耀","poet":"屈原","source":"远游"},{"hex":"#B9A272","name2":"更金","poem":"试问夜如何，夜已三更，金波淡、玉绳低转","poet":"苏轼","source":"洞仙歌"},{"hex":"#B9BEC4","name2":"残雪","poem":"亂山残雪夜，孤灯異乡人","poet":"孟浩然","source":"岁除夜有懷"},{"hex":"#BA8E1C","name2":"蹙金","poem":"绣羅衣裳照暮春，蹙金孔雀银麒麟","poet":"杜甫","source":"丽人行"},{"hex":"#BABEC4","name2":"银篦","poem":"银篦未忍轻挑下，只恐暗风吹烬","poet":"李天骥","source":"摸鱼儿"},{"hex":"#BACEDD","name2":"飞霜","poem":"月照城头乌半飞，霜淒万树风入衣","poet":"李頎","source":"琴歌"},{"hex":"#BBB7B0","name2":"素巾","poem":"素巾空染，泪痕斑、应是暗中滴","poet":"陈三聘","source":"梦玉人引"},{"hex":"#BCBBB4","name2":"头白","poem":"长安城头头白乌，夜飞延秋门上呼","poet":"杜甫","source":"哀王孫"},{"hex":"#BCE672","name2":"春芥","poem":"野火烧不尽，春风吹又生","poet":"白居易","source":"赋得古原草送别"},{"hex":"#BCECE7","name2":"晴霁","poem":"水光潋滟晴方好，山色空蒙雨亦奇","poet":"苏轼","source":"饮湖上初晴后雨"},{"hex":"#BD6157","name2":"有丹","poem":"纵有丹青谁便忍，轻点肌肤冰雪","poet":"李久善","source":"念奴娇"},{"hex":"#BDC5D1","name2":"箔银","poem":"攬衣推枕起裴回，珠箔银屏邐迤开","poet":"白居易","source":"长恨歌"},{"hex":"#BEA333","name2":"微黄","poem":"山石犖確行径微，黄昏到寺蝙蝠飞","poet":"韓愈","source":"山石"},{"hex":"#BF6B5E","name2":"浅朱","poem":"地覆天翻，河清海浅，朱颜常驻","poet":"刘克庄","source":"水龙吟"},{"hex":"#BFDADF","name2":"远缥","poem":"渚寒烟淡，棹移人远，缥缈行舟如叶","poet":"姜夔","source":"八归"},{"hex":"#C0C4C3","name2":"鹭灰","poem":"两个黄鹂鸣翠柳，一行白鹭上青天","poet":"杜甫","source":"绝句"},{"hex":"#C1681C","name2":"香橙","poem":"压枝橄榄浑如画，透甲香橙半弄黄","poet":"李洪","source":"鹧鸪天"},{"hex":"#C17468","name2":"灯朱","poem":"残灯朱幌，淡月纱窗，那时风景","poet":"陆淞","source":"瑞鹤仙"},{"hex":"#C1BDB7","name2":"素姿","poem":"素姿倾国，□难昏、坐觉愆期","poet":"徐鹿卿","source":"汉宫春"},{"hex":"#C26576","name2":"外嫣","poem":"群英外，嫣然一笑，富贵出添姿","poet":"沈端节","source":"满庭芳"},{"hex":"#C28181","name2":"净绛","poem":"长天净，绛河清浅，皓月婵娟","poet":"柳永","source":"戚氏"},{"hex":"#C2A464","name2":"双金","poem":"窄袖轻罗，暗露双金钏","poet":"欧阳修","source":"蝶恋花"},{"hex":"#C3272B","name2":"绛雪","poem":"一道残阳铺水中，半江瑟瑟半江红","poet":"白居易","source":"暮江吟"},{"hex":"#C35045","name2":"牡丹","poem":"晓寒慵揭珠帘，牡丹院落花开未","poet":"王沂孙","source":"水龙吟"},{"hex":"#C36953","name2":"烟霞","poem":"惟觉时之枕席，失向来之烟霞","poet":"李白","source":"夢游天姥吟留別"},{"hex":"#C3C8CE","name2":"肌雪","poem":"天工付与，冰肌雪骨，暗香寒凝","poet":"何梦桂","source":"水龙吟"},{"hex":"#C3DEFB","name2":"髯雪","poem":"镜里半髯雪，向老春深莺晓处","poet":"吴文英","source":"绕佛阁"},{"hex":"#C6D2E5","name2":"银缸","poem":"银缸挑尽，纱窗未晓，独拥寒衾一半","poet":"无名氏","source":"洞仙歌"},{"hex":"#C6D6E8","name2":"霜雪","poem":"岁暮阴阳催短景，天涯霜雪霽寒宵","poet":"杜甫","source":"阁夜"},{"hex":"#C6DFD5","name2":"烟渚","poem":"移舟泊烟渚，日暮客愁新","poet":"孟浩然","source":"宿建德江"},{"hex":"#C7524E","name2":"肠红","poem":"斩新弄，晓来无比格，半坼断肠红","poet":"刘弇","source":"内家娇"},{"hex":"#C7DBEA","name2":"繁霜","poem":"艰难苦恨繁霜鬢，潦倒新停浊酒桮","poet":"杜甫","source":"登高"},{"hex":"#C89B40","name2":"金穗","poem":"春种一粒粟，秋收万颗子","poet":"李绅","source":"悯农"},{"hex":"#C8CFD4","name2":"淡霜","poem":"月淡霜天，今夜空清坐","poet":"张元干","source":"点绛唇"},{"hex":"#C93756","name2":"绯樱","poem":"去年今日此门中，人面桃花相映红","poet":"崔护","source":"题都城南庄"},{"hex":"#C9A90C","name2":"得黄","poem":"陌上踏歌来何暮，收得黄云如土","poet":"刘辰翁","source":"金缕曲・贺新郎"},{"hex":"#C9CED4","name2":"皎皎","poem":"抚余马兮安驱，夜皎皎兮既明","poet":"屈原","source":"东君"},{"hex":"#CA7A2C","name2":"铜晖","poem":"山光悦鸟性，潭影空人心","poet":"常建","source":"题破山寺后禅院"},{"hex":"#CA8A95","name2":"使胭","poem":"雅淡容仪妃子样，羞使胭脂点触","poet":"卢炳","source":"贺新郎"},{"hex":"#CA99D6","name2":"染霓","poem":"浅染霓裳，轻匀汉额，巫山行雨方还","poet":"侯置","source":"凤皇台上忆吹箫・凤凰台上忆吹箫"},{"hex":"#CBBBA1","name2":"含素","poem":"含素水而蒙深兮，日眇眇而既远","poet":"东方朔","source":"哀命"},{"hex":"#CC6349","name2":"灼灼","poem":"东君著意，化工恩被，灼灼妖艳","poet":"无名氏","source":"宝鼎现"},{"hex":"#CCCBC3","name2":"眩白","poem":"方世俗之幽昏兮，眩白黑之美恶","poet":"贾谊","source":"惜誓"},{"hex":"#CE7069","name2":"红烛","poem":"红烛秋光冷画屏，轻羅小扇撲流螢","poet":"杜牧","source":"秋夕"},{"hex":"#CEE9FD","name2":"对霜","poem":"待觅西湖半曲，对霜天清晓","poet":"赵以夫","source":"孤鸾"},{"hex":"#CF7184","name2":"上胭","poem":"晓来雨过，正海棠枝上，胭脂如滴","poet":"王炎2","source":"念奴娇"},{"hex":"#CFCCB2","name2":"白发","poem":"白发千茎相送，深杯百罚休辞","poet":"苏轼","source":"西江月"},{"hex":"#D09945","name2":"煌煌","poem":"牧野洋洋，檀车煌煌，驷騵彭彭","poet":"佚名","source":"大明"},{"hex":"#D0B56A","name2":"林缃","poem":"正艳杏烧林，缃桃绣野，芳景如屏","poet":"柳永","source":"木兰花慢"},{"hex":"#D1A84B","name2":"使金","poem":"人生得意须尽欢，莫使金尊空對月","poet":"李白","source":"鼓吹曲辞 將进酒"},{"hex":"#D1CDC7","name2":"轻素","poem":"雪苑旧精神，燕席吟窗，昨夜生轻素","poet":"无名氏","source":"醉花阴"},{"hex":"#D26E5E","name2":"排虹","poem":"便阊阖轻排，虹河平溯","poet":"吴文英","source":"齐天乐"},{"hex":"#D276A4","name2":"海棠","poem":"试问卷帘人，却道海棠依旧","poet":"李清照","source":"如梦令"},{"hex":"#D2B48C","name2":"砚砂","poem":"纸上得来终觉浅，绝知此事要躬行","poet":"陆游","source":"冬夜读书示子聿"},{"hex":"#D39F00","name2":"与金","poem":"付与金衣清晓，花深未起","poet":"吴文英","source":"三姝媚"},{"hex":"#D3DFF3","name2":"入银","poem":"误惊梦晓，掠芙蓉、度影入银塘","poet":"周密","source":"木兰花慢"},{"hex":"#D4D2BF","name2":"知白","poem":"醉臥不知白日暮，有时空望孤云高","poet":"李頎","source":"送陈章甫"},{"hex":"#D55F59","name2":"台红","poem":"日光斜照集灵台，红树花迎晓露开","poet":"張祜","source":"集灵台二首 一"},{"hex":"#D85916","name2":"橘火","poem":"一年好景君须记，最是橙黄橘绿时","poet":"苏轼","source":"赠刘景文"},{"hex":"#D8D0C3","name2":"颗素","poem":"更留人、绀丸半颗，素瓯泛雪","poet":"王沂孙","source":"解连环"},{"hex":"#D8E3EE","name2":"雪浪","poem":"雪浪堆边呼小渡，吴楚半江分坼","poet":"吴潜","source":"酹江月・念奴娇"},{"hex":"#D95C4B","name2":"水虹","poem":"飞梁压水，虹影澄清晓","poet":"林外","source":"洞仙歌"},{"hex":"#D9988D","name2":"注朱","poem":"淡妆娇面，轻注朱唇，一朵梅花","poet":"辛弃疾","source":"眼儿媚"},{"hex":"#D9B611","name2":"栀明","poem":"梅子金黄杏子肥，麦花雪白菜花稀","poet":"范成大","source":"四时田园杂兴"},{"hex":"#DAC46D","name2":"似黄","poem":"争似黄昏闲弄影，清浅一溪霜月","poet":"朱熹","source":"念奴娇"},{"hex":"#DAC4A6","name2":"芦雪","poem":"蒹葭苍苍，白露为霜","poet":"《诗经》","source":"蒹葭"},{"hex":"#DADEE5","name2":"胧银","poem":"空街烟暝半开，斜日朦胧，银河澄淡风凄楚","poet":"刘焘","source":"八宝妆"},{"hex":"#DB8A96","name2":"笑嫣","poem":"艳歌浅拜笑嫣然","poet":"贺铸","source":"雁后归・临江仙"},{"hex":"#DB8E7A","name2":"标霞","poem":"两两轻舠飞画楫，竞夺锦标霞烂","poet":"柳永","source":"破阵乐"},{"hex":"#DCDBDB","name2":"轻霰","poem":"忽如一夜春风来，千树万树梨花开","poet":"岑参","source":"白雪歌送武判官归京"},{"hex":"#DD939E","name2":"与嫣","poem":"别有淡容仪，又不与、嫣然同笑","poet":"无名氏","source":"蓦山溪"},{"hex":"#DD9684","name2":"残霞","poem":"真如画，残霞淡日，偏向柳梢明","poet":"晁端礼","source":"满庭芳"},{"hex":"#DFBC73","name2":"浴金","poem":"倦浴金莲轻衫步，捧笙玉笋半当胸","poet":"陈允平","source":"浣溪沙"},{"hex":"#DFCA7D","name2":"度黄","poem":"淡月秋千，落花庭院，几度黄昏","poet":"周密","source":"眼儿媚"},{"hex":"#E0DED3","name2":"须白","poem":"左车牙落，半分臂小，几茎须白","poet":"刘克庄","source":"水龙吟"},{"hex":"#E0E5EB","name2":"带雪","poem":"一枝清淡，疏疏带雪，昨夜初开","poet":"无名氏","source":"人月圆"},{"hex":"#E1AEB6","name2":"萼胭","poem":"小桃破萼，胭脂淡伫，妆粉轻笼","poet":"无名氏","source":"朝中措"},{"hex":"#E1C34B","name2":"黄砂","poem":"黄砂直上白云间，一片孤城万仞山","poet":"王之渙","source":"横吹曲辞 出塞"},{"hex":"#E1DDD7","name2":"香素","poem":"暗香素蕊，横枝疏影，月淡风斜","poet":"赵彦端","source":"眼儿媚"},{"hex":"#E1E5EB","name2":"干银","poem":"珠斗阑干，银河清浅，梦籋帝关","poet":"赵福元","source":"沁园春"},{"hex":"#E27A8C","name2":"蕖嫣","poem":"数朵芙蕖，嫣然一笑凌清晓","poet":"汪莘","source":"点绛唇"},{"hex":"#E29C45","name2":"琥光","poem":"夕阳无限好，只是近黄昏","poet":"李商隐","source":"登乐游原"},{"hex":"#E37F65","name2":"烟霞","poem":"烟霞万壑，记曲径幽寻，霁痕初晓","poet":"张炎","source":"扫花游・扫地游"},{"hex":"#E4C6D0","name2":"绫霞","poem":"沾衣欲湿杏花雨，吹面不寒杨柳风","poet":"志南","source":"绝句"},{"hex":"#E5C95E","name2":"黄叶","poem":"黄叶缤纷，碧江清浅，锦水秋暮","poet":"杨无咎","source":"永遇乐"},{"hex":"#E5DDD0","name2":"縞素","poem":"此皆骑戰一敵万，縞素漠漠开风沙","poet":"杜甫","source":"韋諷录事宅观曹將军画马圖"},{"hex":"#E5F0FC","name2":"上雪","poem":"誓將上雪列聖恥，坐法宮中朝