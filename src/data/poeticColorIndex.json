淡轻黄体性柔","poet":"李清照","source":"鹧鸪天"},{"hex":"#F5F2E3","name2":"烟白","poem":"轻棹暮天归路，袅芙蓉烟白","poet":"赵令畤","source":"好事近"},{"hex":"#F5F9FF","name2":"银河","poem":"银河浓淡，华星明灭，轻云时度","poet":"柳永","source":"女冠子"},{"hex":"#FAF9F1","name2":"体白","poem":"形体白而质素兮，中皎洁而淑清","poet":"庄忌","source":"哀时命"},{"hex":"#FAFF72","name2":"新芽","poem":"春眠不觉晓，处处闻啼鸟","poet":"孟浩然","source":"春晓"},{"hex":"#FBB2AB","name2":"日红","poem":"轻云浅护霜，晓日红生砌","poet":"周紫芝","source":"生查子"},{"hex":"#FDDC5B","name2":"月黄","poem":"二月黄鶯飞上林，春城紫禁晓阴阴","poet":"钱起","source":"贈闕下裴舍人"},{"hex":"#FDE5B4","name2":"金门","poem":"金门晓，玉京春，骏马骤轻尘","poet":"薛昭蕴","source":"喜迁莺·金门晓"},{"hex":"#FDEBA8","name2":"铅黄","poem":"雅淡精神，铅黄未洗，犹带残妆","poet":"卢炳","source":"柳梢青"},{"hex":"#FEE484","name2":"金黄","poem":"一身绣出，两同心字，浅浅金黄","poet":"欧阳修","source":"好女儿令・好女儿"},{"hex":"#FF2121","name2":"霓红","poem":"日照香炉生紫烟，遥看瀑布挂前川","poet":"李白","source":"望庐山瀑布"},{"hex":"#FF4C00","name2":"晚照","poem":"夕阳西下，断肠人在天涯","poet":"马致远","source":"天净沙·秋思"},{"hex":"#FFC12C","name2":"金粟","poem":"迟日江山丽，春风花草香","poet":"杜甫","source":"绝句"},{"hex":"#FFEBA1","name2":"惜黄","poem":"象板且须歌皓齿，袅蹄何苦惜黄金","poet":"黄机","source":"浣溪沙"},{"hex":"#FFF7EB","name2":"清素","poem":"晓露凝香，柔条千里，轻盈清素","poet":"赵长卿","source":"水龙吟"},{"hex":"#FFF9E1","name2":"轻黄","poem":"浅绿还池，轻黄归柳，老去愿春迟","poet":"方千里","source":"少年游"}]
